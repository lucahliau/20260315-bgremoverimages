{
  "name": "remove-backgrounds",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npx tsx remove-bg.ts",
    "start:parallel": "npx tsx remove-bg-parallel.ts",
    "serve": "npx tsx server.ts",
    "generate-html": "npx tsx generate-html.ts",
    "view": "npx tsx generate-html.ts && open before-after.html",
    "ui": "npx tsx server.ts",
    "ui:static": "npx tsx generate-ui.ts",
    "ui:open": "npx tsx generate-ui.ts && open before-after.html",
    "tag-nobg": "python3 tag-nobg-quality.py",
    "embed": "python3 embed_worker.py",
    "embed:run": "./run_embed.sh",
    "embed:setup": "python3 -m venv venv && ./venv/bin/pip install sentence-transformers psycopg2-binary pgvector pillow requests torch",
    "tag-clothing": "python3 tag_clothing_worker.py",
    "tag-clothing:run": "./venv/bin/python3 tag_clothing_worker.py --device mps",
    "tag-clothing:setup": "./venv/bin/pip install open_clip_torch"
  },
  "dependencies": {
    "pg": "^8.14.1",
    "@aws-sdk/client-s3": "^3.1009.0",
    "@aws-sdk/lib-storage": "^3.1009.0",
    "@aws-sdk/s3-request-presigner": "^3.1009.0",
    "@smithy/node-http-handler": "^4.4.16",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.11",
    "typescript": "^5.6.0"
  }
}
